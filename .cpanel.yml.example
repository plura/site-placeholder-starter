---
# cPanel Git Version Control deploy manifest. OPTIONAL — only for hosts whose cPanel offers
# "Git™ Version Control" under Files. Projects on plain SFTP don't need this file at all; see
# docs/deploying.md for which pattern fits.
#
# THIS FILE MOVES UP ONE LEVEL ON INSTALL. Everything else in this repo becomes the project's
# placeholder/ directory, but cPanel only reads .cpanel.yml from the REPO root — so copy it to
# the repo root, next to README.md, not inside placeholder/. Same goes for
# .github/workflows/deploy.yml.example. They are the only two files here that do that, and the
# paths below already assume it.
#
# Then: drop the .example suffix, replace USER with the cPanel account name, and edit the
# include-list to match what this project actually deploys.
#
# An explicit include-list, never a mirror. Two consequences, both load-bearing:
#
#   1. starter/app/config.php survives every deploy, because nothing here names it. It is
#      gitignored, so a git deploy could never carry it anyway — upload it once over SFTP.
#   2. cp -R CANNOT DELETE. Removing a file from the repo does not remove it from the webroot,
#      ever. That cleanup is manual, and it is the one thing this pattern does worse than a
#      mirroring SFTP sync.
deployment:
  tasks:
    - export DEPLOYPATH=/home/USER/public_html/
    - /bin/cp -R placeholder/index.html $DEPLOYPATH
    - /bin/cp -R placeholder/robots.txt $DEPLOYPATH
    - /bin/cp -R placeholder/sitemap.xml $DEPLOYPATH
    - /bin/cp -R placeholder/site.webmanifest $DEPLOYPATH
    # OPTIONAL (Tier 2): the second language directory. Remove for a single-language site.
    - /bin/cp -R placeholder/pt $DEPLOYPATH
    - /bin/cp -R placeholder/starter $DEPLOYPATH
    # Deliberately absent: mail-templates/, tools/, package.json, docs/. Build-time only —
    # they have no business in a public webroot. Add a line here whenever a new deployable
    # file lands at placeholder/ root, or it silently never reaches the server.
