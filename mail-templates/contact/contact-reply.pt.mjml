<!--
	OPTIONAL (Tier 2): Portuguese auto-reply. A full copy of contact-reply.mjml — MJML has no
	string-injection mechanism, so a translated template means a translated file. Structural
	changes to contact-reply.mjml must be mirrored here; only the copy differs.

	Only the reply is translated. contact.mjml (the notification) goes to the site owner, who
	reads one language regardless of which version the visitor used.

	Compiles to starter/app/templates/contact-reply.pt.html — see the README for the command.
-->
<mjml>
<mj-head>
	<mj-title>Mensagem recebida</mj-title>
	<mj-preview>Obrigado pelo contacto. Aqui fica uma c&oacute;pia do que enviou.</mj-preview>
	<mj-include path="../_partials/_head.mjml" />
</mj-head>
<mj-body>
	<mj-wrapper mj-class="page-frame" css-class="page-frame">

		<mj-include path="../_partials/_header.mjml" />

		<mj-section mj-class="card-body" css-class="card-body" padding="34px 38px 28px">
			<mj-column>
				<mj-include path="_partials/_kicker.mjml" />
				<mj-text mj-class="heading" padding="0">Mensagem recebida</mj-text>
				<mj-text mj-class="intro-text" padding="16px 0 0">
					Obrigado, <strong>%name%</strong>. Receber&aacute; resposta em breve. C&oacute;pia
					da mensagem abaixo.
				</mj-text>
			</mj-column>
		</mj-section>

		<!-- Mesmo parcial usado em contact.mjml para a cópia do proprietário, para que o que o
		     visitante vê aqui corresponda sempre exatamente ao que foi recebido. -->
		<mj-include path="_partials/_fields.mjml" />

		<mj-include path="../_partials/_footer.mjml" />

		<mj-include path="../_partials/_credit.mjml" />

	</mj-wrapper>
</mj-body>
</mjml>
