<!--
	Universal minimum field set. Both halves of every row are runtime placeholders: for a field
	named FIELD, %label_FIELD% is the form's own <label> text and %FIELD% is what was typed.
	To add a field, copy one row + divider pair and rename both placeholders. No submit.php change.
	The message is the last row of the same 20/80 grid, not a separate block. One grid, four pairs.
	These are mj-sections, so this file is included at mj-wrapper level, never inside an mj-column.
	Columns stack under 480px; f-label / f-value / m-label retune that spacing.
-->
<mj-section mj-class="field-row" css-class="field-row">
	<mj-column width="20%">
		<mj-text mj-class="field-label-text" css-class="f-label">%label_name%</mj-text>
	</mj-column>
	<mj-column width="80%">
		<mj-text mj-class="field-value-text" css-class="f-value">%name%</mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="field-row" css-class="field-row">
	<mj-column>
		<mj-divider mj-class="field-divider" />
	</mj-column>
</mj-section>

<mj-section mj-class="field-row" css-class="field-row">
	<mj-column width="20%">
		<mj-text mj-class="field-label-text" css-class="f-label">%label_email%</mj-text>
	</mj-column>
	<mj-column width="80%">
		<mj-text mj-class="field-value-text" css-class="f-value"><a href="mailto:%email%" class="value-link">%email%</a></mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="field-row" css-class="field-row">
	<mj-column>
		<mj-divider mj-class="field-divider" />
	</mj-column>
</mj-section>

<mj-section mj-class="field-row" css-class="field-row">
	<mj-column width="20%">
		<mj-text mj-class="field-label-text" css-class="f-label">%label_phone%</mj-text>
	</mj-column>
	<mj-column width="80%">
		<mj-text mj-class="field-value-text" css-class="f-value"><a href="tel:%phone%" class="value-link">%phone%</a></mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="field-row" css-class="field-row">
	<mj-column>
		<mj-divider mj-class="field-divider" padding="0 0 22px" />
	</mj-column>
</mj-section>

<mj-section mj-class="field-row-last" css-class="field-row-last">
	<mj-column width="20%">
		<mj-text mj-class="message-label-text" css-class="m-label">%label_message%</mj-text>
	</mj-column>
	<mj-column width="80%">
		<mj-text mj-class="message-text">%message%</mj-text>
	</mj-column>
</mj-section>
