<mjml>
<mj-head>
	<mj-title>Message received</mj-title>
	<!-- Written from the visitor's side. Never reuse contact.mjml's preview here: that one is
	     addressed to the site owner and would read oddly to the person who just wrote in. -->
	<mj-preview>Thanks for getting in touch. Here is a copy of what you sent.</mj-preview>
	<mj-include path="../_partials/_head.mjml" />
</mj-head>
<mj-body>
	<mj-wrapper mj-class="page-frame" css-class="page-frame">

		<mj-include path="../_partials/_header.mjml" />

		<!--
			Differs from contact.mjml by exactly two things: this heading string, and the
			intro-text block below it. Everything else, including the _fields.mjml include, is
			identical, which is what guarantees this copy matches the notification.

			Copy stays person-neutral: this starter ships to businesses, collectives and
			one-person studios alike, so no "we" and no "I" — write from the reader's side
			("Message received" / "you'll hear back"), not the sender's. No em dashes.
		-->
		<mj-section mj-class="card-body" css-class="card-body" padding="34px 38px 28px">
			<mj-column>
				<!-- No form-type field in this kicker, unlike contact.mjml's: its value is
				     fixed in the OWNER's language (see the hidden field's comment in
				     index.html), so showing it to the visitor would mix a stray owner-language
				     word into what's otherwise entirely their own. -->
				<mj-include path="_partials/_kicker.mjml" />
				<mj-text mj-class="heading" padding="0">Message received</mj-text>
				<mj-text mj-class="intro-text" padding="16px 0 0">
					Thanks, <strong>%name%</strong>. You&rsquo;ll hear back as soon as possible.
					Below is a copy of what you sent.
				</mj-text>
			</mj-column>
		</mj-section>

		<mj-include path="_partials/_fields.mjml" />

		<mj-include path="../_partials/_footer.mjml" />

		<mj-include path="../_partials/_credit.mjml" />

	</mj-wrapper>
</mj-body>
</mjml>
