<mjml>
<mj-head>
	<mj-title>New enquiry</mj-title>
	<mj-preview>New enquiry — Site Name</mj-preview>
	<mj-include path="../_partials/_head.mjml" />
</mj-head>
<mj-body>
	<mj-wrapper mj-class="page-frame" css-class="page-frame">

		<mj-include path="../_partials/_header.mjml" />

		<mj-section mj-class="card-top" css-class="card-top">
			<mj-column width="70%">
				<mj-text mj-class="heading" padding="0 0 20px">New enquiry</mj-text>
			</mj-column>
			<mj-column width="30%">
				<!-- %lang% is the language version the enquiry came from, pre-formatted by
				     submit.php (" · PT"). Empty on a single-language site, so this needs no
				     Tier 2 marker — it simply renders as the date alone. -->
				<mj-text mj-class="date-text" padding="0 0 20px">%date%%lang%</mj-text>
			</mj-column>
		</mj-section>

		<mj-include path="../_partials/_fields.mjml" />

		<mj-include path="../_partials/_footer.mjml" />
		<mj-include path="../_partials/_credit.mjml" />

	</mj-wrapper>
</mj-body>
</mjml>
