<!--
	BRAND CUSTOMIZATION: this file is the single place brand identity lives for the whole
	mail template. Replace the color/font values below with the client's actual brand tokens.
	Keep the mj-class NAMES and the padding/structural values as-is (in this file and in
	every partial that references them) — those encode layout/responsive behavior, not
	brand identity, and are what make the whole pattern reusable across projects.

	Placeholder palette used here:
	  #eeeeee — frame/background (the color surrounding the white card)
	  #ffffff — card background
	  #111111 — primary text
	  #767676 — muted/secondary text
	  #4a90d9 — accent (divider, message-quote border, cta button text-on-dark)
-->
<mj-attributes>
	<mj-all font-family="Helvetica Neue, Helvetica, Arial, sans-serif" />
	<mj-text font-size="14px" line-height="1.7" color="#111111" />
	<mj-body width="560px" background-color="#eeeeee" />

	<mj-class name="page-frame" background-color="#eeeeee" padding="48px 16px" />
	<mj-class name="header-pad" background-color="#eeeeee" padding="0" />
	<mj-class name="footer-pad" background-color="#eeeeee" padding="28px 48px 20px" />
	<mj-class name="credit-pad" background-color="#eeeeee" padding="0 48px 32px" />
	<mj-class name="body-card" background-color="#ffffff" padding="36px 48px 48px" />
	<mj-class name="card-top" background-color="#ffffff" padding="36px 48px 0" />
	<mj-class name="card-row" background-color="#ffffff" padding="0 48px" />
	<mj-class name="card-bottom" background-color="#ffffff" padding="0 48px 48px" />
	<mj-class name="footer-column" border-top="1px solid #dddddd" padding-top="20px" />

	<mj-class name="logo-image" width="175px" padding="0 0 28px" />
	<mj-class name="accent-divider" border-color="#4a90d9" border-width="3px" padding="0" />

	<mj-class name="heading" font-family="Georgia, 'Times New Roman', serif" font-size="22px" font-weight="400" color="#111111" line-height="1.3" align="left" />
	<mj-class name="date-text" font-size="10px" letter-spacing="0.05em" text-transform="uppercase" color="#767676" align="right" />
	<mj-class name="intro-text" font-size="13px" line-height="1.8" padding="0 0 32px" />
	<mj-class name="urgent-text" font-size="13px" line-height="1.8" align="center" padding="20px 0 0" />
	<mj-class name="field-divider" border-color="#eeeeee" border-width="1px" padding="0 0 20px" />
	<mj-class name="field-label-text" color="#767676" font-size="9px" letter-spacing="0.12em" text-transform="uppercase" align="left" padding="14px 0" />
	<mj-class name="field-value-text" color="#111111" font-size="14px" line-height="1.7" align="left" padding="14px 0" />
	<mj-class name="message-label-text" color="#767676" font-size="9px" letter-spacing="0.12em" text-transform="uppercase" align="left" padding="0 0 4px" />
	<mj-class name="footer-name" align="center" font-size="11px" font-weight="bold" letter-spacing="0.2em" text-transform="uppercase" color="#111111" padding="0 0 6px" />
	<mj-class name="footer-text" align="center" font-size="11px" color="#767676" letter-spacing="0.05em" line-height="1.9" padding="0 0 6px" />
	<mj-class name="credit-text" align="center" font-size="10px" color="#999999" letter-spacing="0.05em" />
	<mj-class name="cta-button" background-color="#111111" color="#ffffff" font-size="12px" font-weight="300" letter-spacing="0.1em" text-transform="uppercase" border-radius="0" align="center" padding="24px 0 0" inner-padding="14px 32px" />
</mj-attributes>

<mj-style inline="inline">
	.header-link { color: #111111; text-decoration: none; }
	.footer-link { color: #767676; text-decoration: none; }
	.credit-link { color: #999999; text-decoration: none; font-weight: bold; }
	.urgent-link { color: #111111; font-weight: bold; text-decoration: underline; text-decoration-color: #4a90d9; }
	.message-quote { background: #eeeeee; border-left: 3px solid #4a90d9; padding: 16px 20px; font-size: 14px; line-height: 1.7; color: #111111; }
</mj-style>

<mj-style>
	@media only screen and (max-width: 480px) {
		.page-frame > table > tbody > tr > td { padding: 24px !important; }
		.body-card > table > tbody > tr > td { padding: 28px 24px 32px !important; }
		.card-top > table > tbody > tr > td { padding: 28px 24px 0 !important; }
		.card-row > table > tbody > tr > td { padding: 0 24px !important; }
		.card-bottom > table > tbody > tr > td { padding: 0 24px 32px !important; }
		.footer-pad > table > tbody > tr > td { padding: 24px 24px 16px !important; }
		.credit-pad > table > tbody > tr > td { padding: 0 24px 24px !important; }
	}
</mj-style>

<mj-raw>
	<meta name="x-apple-disable-message-reformatting">
	<meta name="color-scheme" content="light">
	<meta name="supported-color-schemes" content="light">
	<meta name="format-detection" content="telephone=no, email=no, address=no">
</mj-raw>
